{
  "expo": {
    "name": "Écarlate",
    "slug": "anneau-ecarlate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anneauecarlate",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D0A0B",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.perso.anneauecarlate",
      "supportsTablet": false
    },
    "android": {
      "package": "com.perso.anneauecarlate",
      "adaptiveIcon": {
        "backgroundColor": "#0D0A0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.VIBRATE"
      ],
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0A0B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0D0A0B",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E0142B",
          "defaultChannel": "rappels-anneau",
          "enableRemoteNotifications": false
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "08d6c002-f41d-4214-97db-f4541f62eb2e"
      }
    },
    "owner": "eferrier"
  }
}
